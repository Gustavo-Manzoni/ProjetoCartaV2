  interactionPrompt: "Ler o relat\xF3rio de manuten\xE7\xE3o"
  available: 1
  blockedThought: 
  onFocusEntered:
    m_PersistentCalls:
      m_Calls: []
  onFocusExited:
    m_PersistentCalls:
      m_Calls: []
  title: "Relat\xF3rio de manuten\xE7\xE3o"
  documentTexture: {fileID: 2800000, guid: 9b231ff7d2ca252408d98454f97ec74b, type: 3}
  readThought: "Tr\xEAs hor\xE1rios anotados com cuidado demais para uma simples
    escala."
  body: "GUINCHO DO PO\xC7O\n\nDesde a chuva, o balde n\xE3o desce com a trava
    solta por qualquer um. Ela s\xF3 abre quando o rel\xF3gio marca:\n3h00 \xB7 7h30 \xB7
    10h30\n\nOs ponteiros andam de uma hora e meia em uma hora e meia.\n\nA manivela
    est\xE1 na caixa perto do radiador. Guardem depois de usar.\n\nOsvaldo"
  bodyFont: {fileID: 11400000, guid: 56b1a46ef2d2dcb4f8cf3d83de8ba976, type: 2}
  bodyFontSize: 36
  centerText: 1
  bodyArea:
    serializedVersion: 2
    x: 0.11
    y: 0.08
    width: 0.78
    height: 0.84
