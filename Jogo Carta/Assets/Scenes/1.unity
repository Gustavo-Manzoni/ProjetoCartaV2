  title: Bilhete de Helena
  documentTexture: {fileID: 2800000, guid: 9b231ff7d2ca252408d98454f97ec74b, type: 3}
  readThought: "Ela ligou \xE0s 23:52. Ningu\xE9m atendeu."
  body: "A quem estiver de plant\xE3o na guarita:\n\no governador assinou o indulto
    de Tom\xE1s Ferraz \xE0s 23:40. O mensageiro j\xE1 saiu com a ordem, mas a ponte
    est\xE1 fechada pela chuva.\n\nUse esta ficha no telefone da guarita e avise
    a c\xE2mara.\nAinda d\xE1 tempo.\n\nHelena Duarte \u2014 23:44"
  bodyFont: {fileID: 11400000, guid: 12e09b1cebdaac04e92ac6c3d37c0e77, type: 2}
  bodyFontSize: 38
  bodyArea:
    serializedVersion: 2
    x: 0.1
    y: 0.06
    width: 0.8
    height: 0.86
