  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjetoCarta.Puzzles.ReadableDocument
  interactionPrompt: "Ler o livro de plant\xE3o"
  available: 1
  blockedThought: 
  onFocusEntered:
    m_PersistentCalls:
      m_Calls: []
  onFocusExited:
    m_PersistentCalls:
      m_Calls: []
  title: "Livro de plant\xE3o"
  documentTexture: {fileID: 2800000, guid: 9b231ff7d2ca252408d98454f97ec74b, type: 3}
  readThought: "O perd\xE3o chegou \xE0s 00:21. Vinte e um minutos tarde."
  body: "Noite de 20 para 21 de novembro de 1958\n\n23:30  Condenado Tom\xE1s Ferraz
    levado \xE0 c\xE2mara.\n23:40  Revista: o rel\xF3gio de bolso do condenado cai
    no po\xE7o do p\xE1tio.\n23:45  Diretor fecha a c\xE2mara. A chave da c\xE2mara,
    que abre a caixa de controle, vai para o cofre do juiz.\n23:50  Recado para o
    condenado chega \xE0 guarita. Ordem: nada entra. Jogado no po\xE7o.\n23:52  O
    telefone da guarita toca. Ningu\xE9m atende.\n23:58  \xDAltima verifica\xE7\xE3o
    da caixa de controle da cadeira.\n00:00  Senten\xE7a executada.\n00:21  Mensageiro
    do Pal\xE1cio chega com o despacho do indulto. A ponte estava fechada pela chuva."
  bodyFont: {fileID: 11400000, guid: 56b1a46ef2d2dcb4f8cf3d83de8ba976, type: 2}
  bodyFontSize: 28
  bodyArea:
    serializedVersion: 2
    x: 0.1
    y: 0.06
    width: 0.8
    height: 0.86
