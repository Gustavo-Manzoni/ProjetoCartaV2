  interactionPrompt: "Ler a senten\xE7a"
  available: 1
  blockedThought: 
  onFocusEntered:
    m_PersistentCalls:
      m_Calls: []
  onFocusExited:
    m_PersistentCalls:
      m_Calls: []
  title: "Senten\xE7a"
  documentTexture: {fileID: 2800000, guid: 9b231ff7d2ca252408d98454f97ec74b, type: 3}
  readThought: "Uma \xFAnica testemunha. E a execu\xE7\xE3o marcada para a meia-noite."
  body: "TRIBUNAL DO J\xDARI \u2014 PROCESSO N\xBA 347/57\n14 de mar\xE7o de 1958\n\nO
    r\xE9u Tom\xE1s Ferraz \xE9 condenado pela morte do vigia do cais.\nA acusa\xE7\xE3o
    se apoia numa \xFAnica testemunha ocular.\n\nPena: morte na cadeira el\xE9trica
    da Penitenci\xE1ria Estadual.\nExecu\xE7\xE3o marcada para a meia-noite de 20
    para 21 de novembro de 1958.\n\nAssinado a caneta-tinteiro pelo juiz-presidente."
  bodyFont: {fileID: 11400000, guid: 56b1a46ef2d2dcb4f8cf3d83de8ba976, type: 2}
  bodyFontSize: 30
  bodyArea:
    serializedVersion: 2
    x: 0.11
    y: 0.08
    width: 0.78
    height: 0.84
